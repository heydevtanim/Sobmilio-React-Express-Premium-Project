generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
enum Role { CUSTOMER SELLER SUPPLIER SUPER_ADMIN ADMIN FINANCE_MANAGER PRODUCT_MANAGER SUPPORT_STAFF OPERATIONS_STAFF }
enum ProductStatus { DRAFT PENDING_APPROVAL ACTIVE REJECTED ARCHIVED }
enum OrderStatus { PENDING CONFIRMED PROCESSING SHIPPED DELIVERED CANCELLED RETURN_REQUESTED REFUNDED }
enum PaymentMethod { COD BKASH NAGAD CARD }
enum PaymentStatus { UNPAID PENDING PAID FAILED REFUNDED PARTIALLY_REFUNDED }
model User { id String @id @default(cuid()) name String? email String? @unique phone String? @unique passwordHash String? roles Role[] @default([CUSTOMER]) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt stores Store[] orders Order[] reviews Review[] }
model Store { id String @id @default(cuid()) ownerId String owner User @relation(fields:[ownerId],references:[id]) name String slug String @unique description String? logoUrl String? coverUrl String? isVerified Boolean @default(false) isActive Boolean @default(false) createdAt DateTime @default(now()) listings SellerListing[] }
model Category { id String @id @default(cuid()) name String nameBn String? slug String @unique description String? parentId String? parent Category? @relation("CategoryTree",fields:[parentId],references:[id]) children Category[] @relation("CategoryTree") products Product[] sortOrder Int @default(0) isActive Boolean @default(true) }
model Brand { id String @id @default(cuid()) name String slug String @unique products Product[] }
model Product { id String @id @default(cuid()) title String slug String @unique description String? categoryId String category Category @relation(fields:[categoryId],references:[id]) brandId String? brand Brand? @relation(fields:[brandId],references:[id]) status ProductStatus @default(DRAFT) createdAt DateTime @default(now()) listings SellerListing[] reviews Review[] }
model SellerListing { id String @id @default(cuid()) productId String product Product @relation(fields:[productId],references:[id]) storeId String store Store @relation(fields:[storeId],references:[id]) sku String? @unique price Decimal @db.Decimal(12,2) compareAtPrice Decimal? @db.Decimal(12,2) stock Int @default(0) isActive Boolean @default(true) orderItems OrderItem[] @@index([storeId,isActive]) @@index([productId,isActive]) }
model Order { id String @id @default(cuid()) orderNumber String @unique customerId String customer User @relation(fields:[customerId],references:[id]) status OrderStatus @default(PENDING) paymentMethod PaymentMethod paymentStatus PaymentStatus @default(UNPAID) subtotal Decimal @db.Decimal(12,2) shippingFee Decimal @default(0) @db.Decimal(12,2) total Decimal @db.Decimal(12,2) createdAt DateTime @default(now()) sellerOrders SellerOrder[] }
model SellerOrder { id String @id @default(cuid()) orderId String order Order @relation(fields:[orderId],references:[id]) storeId String status OrderStatus @default(PENDING) subtotal Decimal @db.Decimal(12,2) items OrderItem[] @@index([storeId,status]) }
model OrderItem { id String @id @default(cuid()) sellerOrderId String sellerOrder SellerOrder @relation(fields:[sellerOrderId],references:[id]) listingId String listing SellerListing @relation(fields:[listingId],references:[id]) titleSnapshot String unitPrice Decimal @db.Decimal(12,2) quantity Int }
model Review { id String @id @default(cuid()) productId String product Product @relation(fields:[productId],references:[id]) userId String user User @relation(fields:[userId],references:[id]) rating Int title String? body String? createdAt DateTime @default(now()) @@unique([productId,userId]) }
